config KOBITOKEY_POINTING
    bool "KobitoKey Studio pointing and automatic mouse support"
    depends on ZMK_POINTING && ZMK_SPLIT_ROLE_CENTRAL
    select ZMK_CUSTOM_SETTINGS
    select ZMK_CUSTOM_SETTINGS_STUDIO_RPC

config KOBITOKEY_ALT_TAB
    bool "KobitoKey held Alt-Tab combo behavior"
    depends on ZMK_RUNTIME_COMBO && ZMK_SPLIT_ROLE_CENTRAL
