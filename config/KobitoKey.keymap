#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <120>;
};

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <120>;
};

/ {
    macros {
        my_kakko: my_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9)>;
        };

        my_kagi: my_kagi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET &kp NUHS>;
            label = "MY_KAGI";
        };

    };

    combos {
        compatible = "zmk,combos";

        PASTE_VALUE {
            bindings = <&kp LS(LC(V))>;
            key-positions = <22 23>;
            layers = <0>;
            timeout-ms = <80>;
        };

        KAKKO {
            bindings = <&my_kakko>;
            key-positions = <14 15>;
            timeout-ms = <80>;
            layers = <0>;
        };

        KAGIKAKKO {
            bindings = <&my_kagi>;
            key-positions = <4 5>;
            layers = <0>;
            timeout-ms = <80>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
&kp Q      &kp W     &kp E     &kp R        &kp T      &kp Y     &kp U        &kp I      &kp O      &kp P
&mt LALT A &kp S     &kp D     &kp F        &kp G      &kp H     &kp J        &kp K      &kp L      &kp BSPC
&kp Z      &kp X     &kp C     &kp V        &kp B      &kp N     &kp M        &kp COMMA  &kp DOT    &kp SLASH
&lt 4 ESC  &kp LWIN  &mt LCTRL GRAVE  &mt LSHIFT SPACE  &mt LC(LSHIFT) MINUS  &lt 2 TAB  &lt 1 ENTER  &none  &kp LS(F10)  &lt 3 DOT
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp KP_SLASH     &kp N7  &kp N8  &kp N9          &kp KP_MINUS   &none           &mkp MB4          &kp UP        &mkp MB5           &kp LC(SPACE)
&mt LALT KP_ASTERISK  &kp N4  &kp N5  &kp N6     &kp KP_PLUS    &kp LC(LS(N9))  &kp LEFT          &kp DOWN      &kp RIGHT          &kp DEL
&kp N0           &kp N1  &kp N2  &kp N3          &kp LS(MINUS)  &kp RALT        &kp LS(LG(LEFT))  &kp LA(DOWN)  &kp LS(LG(RIGHT))  &none
&trans           &trans  &trans  &mt LSHIFT F10  &trans         &trans          &trans            &none         &trans             &trans
            >;
        };

        layer2 {
            label = "SYMBOL";
            bindings = <
&kp LS(SLASH)  &kp LS(N2)  &kp LS(N1)  &none          &kp LS(EQUAL)  &kp INT3    &kp LS(INT1)  &none     &none    &kp LS(N5)
&kp LBKT       &kp LS(N7)  &kp LS(N4)  &none          &kp LS(LBKT)   &kp LS(N3)  &none         &none     &none    &none
&none          &none       &kp EQUAL   &kp LS(INT3)   &none          &kp LS(N6)  &none         &kp SEMI  &kp SQT  &none
&none          &none       &trans      &kp LS(SPACE)  &none          &trans      &trans        &none     &none    &none
            >;
        };

        layer3 {
            label = "FUNCTION";
            bindings = <
&none          &kp F7  &kp F8  &kp F9  &kp F10  &kp HOME  &kp PG_UP  &kp LC(SEMI)  &kp LC(SQT)  &tog 5
&kp LC(LA(V))  &kp F4  &kp F5  &kp F6  &kp F11  &kp END   &kp PG_DN  &none         &none        &none
&kp LC(SEMI)   &kp F1  &kp F2  &kp F3  &kp F12  &none     &none      &none         &none        &none
&kp LC(LA(DEL))  &none  &none  &none   &kp LS(CAPS)  &none  &none    &none         &none        &none
            >;
        };

        layer4 {
            label = "SHORTCUT";
            bindings = <
&kp LA(LG(K))  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp RBKT      &kp NUHS      &kp LC(PG_UP)    &kp LG(UP)     &kp LC(PG_DN)  &none
&none          &none       &none         &none         &kp LS(N8)    &kp LS(N9)    &kp LG(LEFT)     &kp LG(DOWN)   &kp LG(RIGHT)  &none
&none          &none       &none         &none         &kp LS(RBKT)  &kp LS(NUHS)  &kp LC(LS(TAB))  &kp LS(LG(S))  &kp LC(TAB)    &none
&none          &none       &none         &none         &none         &none         &none            &none          &none          &none
            >;
        };

        layer5 {
            label = "BLUETOOTH";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &to 0
&none        &none        &none        &none        &bt BT_CLR      &none  &none  &none  &none  &none
&none        &none        &none        &none        &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&none        &none        &none        &none        &none          &none  &none  &none  &none  &none
            >;
        };

        layer6 {
            label = "MOUSE";
            bindings = <
&none     &none  &none    &none    &kp T  &kp Y  &mkp MB1  &mkp MB3  &mkp MB2  &none
&mt LALT A  &none  &kp D  &kp F    &kp G  &kp H  &none    &none    &none    &none
&none     &none  &kp C    &kp V    &none  &none  &none    &none    &none    &none
&none      &none  &mt LCTRL GRAVE  &mt LSHIFT SPACE  &mt LC(LSHIFT) MINUS  &none  &none  &none  &none  &none
            >;
        };

    };
};
