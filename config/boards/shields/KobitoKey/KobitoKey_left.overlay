#include "kobitokey.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <input/processors/sensor_rotation.dtsi>
#include <input/processors/runtime-input-processor.dtsi>

&xiao_serial { status = "disabled"; };

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    tb_left: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <200>; /* センサー感度 */


        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/ {
    sensor_rotation_left: sensor-rotation-left {
        compatible = "zmk,input-processor-sensor-rotation";
        status = "okay";
        #input-processor-cells = <0>;
        rotation-angle = <(-24)>;
    };

    sensor_rotation_right: sensor-rotation-right {
        compatible = "zmk,input-processor-sensor-rotation";
        #input-processor-cells = <0>;
        status = "okay";
        rotation-angle = <24>;
    };
};

&tb_left_listener {
    status = "okay";
    device = <&tb_left>;

    input-processors =
            <&sensor_rotation_left>,
            <&scroll_runtime_input_processor>;
    };

/ {
  behaviors {
    precision: precision {
      compatible = "kobito,precision";
      display-name = "Pointer precision (hold)";
      #binding-cells = <0>;
    };
  };

  kobito_auto_mouse: auto-mouse {
    compatible = "kobito,auto-mouse";
    #input-processor-cells = <0>;
    layer = <6>;
    excluded-positions = <6 7 8 30 32 33 39>;
  };
};

&tb_right_listener {
    status = "okay";

    input-processors =
        <&sensor_rotation_right>,
        <&kobito_auto_mouse>,
        <&mouse_runtime_input_processor>;
};

/* Keep the mounting-angle corrections above; Studio rotation is an extra offset. */
&scroll_runtime_input_processor {
    /delete-property/ temp-layer-keep-keycodes;
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    scale-divisor = <15>;
    xy-to-scroll-enabled;
    x-invert;
    y-invert;
    axis-snap-mode = <2>;
};

&mouse_runtime_input_processor {
    /delete-property/ temp-layer-keep-keycodes;
    /* Use KobitoKey's position-based auto-mouse processor, not the generic one. */
    temp-layer-deactivation-delay-ms = <5000>;
};
